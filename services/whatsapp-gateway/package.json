{
  "name": "@wba/whatsapp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Fronteira com a WhatsApp Cloud API: webhook (assinatura, idempotência, ACL de entrada) e sender (ACL de saída, retry e DLQ).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "node ../../tools/bundle.mjs src/main-webhook.ts src/main-sender.ts",
    "start:webhook": "node dist/main-webhook.js",
    "start:sender": "node dist/main-sender.js"
  },
  "dependencies": {
    "@wba/contracts": "workspace:*",
    "@wba/messaging": "workspace:*",
    "@wba/observability": "workspace:*",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/rabbitmq": "^11.10.0",
    "@testcontainers/redis": "^11.10.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.20.5",
    "amqplib": "^0.10.9",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
