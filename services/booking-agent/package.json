{
  "name": "@wba/booking-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Domínio de Agendamento, casos de uso e agente LangGraph: consome comandos da fila, chama as ferramentas MCP e publica respostas.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
