    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.5.0",
    "@langchain/langgraph": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@wba/contracts": "workspace:*",
    "amqplib": "^0.10.9",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
