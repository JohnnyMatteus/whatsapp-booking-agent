# Copie para .env e ajuste. Todos os valores abaixo são de DESENVOLVIMENTO (dev-only-*).
# Em produção, segredos vêm de um cofre (ver docs/design-doc.md, Segurança).

# WhatsApp Cloud API (em desenvolvimento, o mock WireMock responde no lugar da Meta)
WHATSAPP_APP_SECRET=dev-only-change-me-app-secret
WHATSAPP_VERIFY_TOKEN=dev-only-verify-token
WHATSAPP_ACCESS_TOKEN=dev-only-access-token
WHATSAPP_API_BASE_URL=http://cloud-api-mock:8080
WHATSAPP_API_VERSION=v23.0
# phone_number_id do número de WhatsApp Business -> slug do estúdio no SaaS
TENANT_PHONE_NUMBERS={"100000000000001":"estudio-lotus"}

# Mensageria
RABBITMQ_USER=wba
RABBITMQ_PASSWORD=dev-only-change-me

# Servidor MCP e SaaS (sem portfolio-net, o saas-mock responde)
MCP_AUTH_TOKEN=dev-only-mcp-token-change-me
SAAS_BASE_URL=http://saas-mock:8080/api
SAAS_DEV_TOKENS={"estudio-lotus":"dev-only-saas-token"}

# LLM compatível com OpenAI (padrão: Ollama local do profile llm)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=dev-only-ollama
LLM_MODEL=qwen2.5:3b-instruct
STUDIO_TIMEZONE=America/Sao_Paulo

# Painel do estúdio
PANEL_API_TOKEN=dev-only-panel-token

# Áudios (MinIO local; na AWS, troque o endpoint e as credenciais)
MINIO_ROOT_USER=wba-admin
MINIO_ROOT_PASSWORD=dev-only-change-me
AUDIO_BUCKET=wba-audio
# fake (padrão) ou faster-whisper (exige build com WITH_WHISPER=1)
TRANSCRIBER=fake

# Observabilidade: com o profile observability, aponte os traces para o Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
GRAFANA_ADMIN_PASSWORD=dev-only-change-me
LOG_LEVEL=info
