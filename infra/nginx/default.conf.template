server {
  listen 8080;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass ${BOOKING_AGENT_URL};
    proxy_set_header Authorization "Bearer ${PANEL_API_TOKEN}";
    proxy_set_header Host $host;
  }

  location /healthz {
    access_log off;
    return 200 'ok';
  }

  location / {
    try_files $uri /index.html;
  }
}
